Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Automatically set the base to the current directory
    RewriteCond %{REQUEST_URI}::$1 ^(.*?/)(.*)::\2$
    RewriteRule ^(.*)$ - [E=BASE:%1]

    # Public pages: /dashboard → /dashboard.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-zA-Z0-9_-]+)$ %{ENV:BASE}$1.php [L,QSA]

    # Admin pages: /admin/login → /assets/app/admin/login.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^admin/([a-zA-Z0-9_-]+)$ %{ENV:BASE}assets/app/admin/$1.php [L,QSA]
</IfModule>